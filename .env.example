# ============================================================
# SAYF Store — Environment Variables
# Copy this file to .env and fill in real credentials
# ============================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String
# For development: leave empty to use in-memory MongoMemoryServer
# For production: use your MongoDB Atlas connection string
MONGODB_URI=
